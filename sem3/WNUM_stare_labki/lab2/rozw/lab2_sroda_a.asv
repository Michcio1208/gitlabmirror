%funckje
function F=obwod(z)

J=2;
r1=1;
r2=2;
r4=5;
ut=0.026;
Is=1e-9;


V1=z(1);
V2=z(2);
V3=z(3);
ir1=z(4);
id1=z(5);
ir2=z(6);
ir4=z(7);


F=[
V1-ir1*r1-V2;
id1-Is*exp(((V2-V3)/ut)-1);
V3-r2*ir2;
V1-r4*ir4;

J-ir1-ir4;
ir1-id1;
id1-ir2;
];


end