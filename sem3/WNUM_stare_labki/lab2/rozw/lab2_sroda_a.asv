fprintf("V3 to %.2f\n",z(3))
fprintf("ir1 to %.2f\n",z(4))
fprintf("id1 to %.2f\n",z(5))
fprintf("ir2 to %.2f\n",z(6))
fprintf("ir4 to %.2f\n",z(7))

